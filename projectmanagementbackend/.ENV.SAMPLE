# ─────────────────────────────────────────────────────────────
# Project Camp — Backend environment template
# Copy to .env and fill in values:  cp .ENV.SAMPLE .env
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=8000

# ── Database ─────────────────────────────────────────────────
MONGO_URI=mongodb://admin:password123@127.0.0.1:27017

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# ── Frontend URLs (used in password-reset + verification email links) ──
FRONTEND_URL=http://localhost:5173

# ── JWT ──────────────────────────────────────────────────────
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=change-me-access-token-secret
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=change-me-refresh-token-secret
REFRESH_TOKEN_EXPIRY=7d

# ── Security ─────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# Auth endpoints are rate-limited by client IP (see docs/04 § 10). Only set
# this when a reverse proxy/load balancer sits in front of the app — it is the
# number of trusted proxy hops (1 for a single nginx). Leaving it unset means
# X-Forwarded-For is ignored, which is the safe default.
# TRUST_PROXY=1

# ── Email verification + mail ────────────────────────────────
# Email verification is a 6-digit OTP (mails an OTP, no link). Outside
# production the code is also returned as `data.devOtp` and logged, so sign-up
# works even when mail delivery is slow. Set NODE_ENV=production to remove it.

# OPTION A (default): leave everything below empty.
#   In development the app auto-creates an Ethereal test account on
#   first send and logs a preview URL (https://ethereal.email) to the
#   console. Zero signup, zero config.
#
# OPTION B: any generic SMTP provider (Gmail app-password, Resend SMTP,
#   Brevo, Mailgun, Postmark, your company SMTP...) via these vars:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Legacy Mailtrap vars are still read as a fallback:
# MAILTRAP_SMTP_HOST, MAILTRAP_SMTP_PORT, MAILTRAP_SMTP_USER, MAILTRAP_SMTP_PASS

# From header for outgoing mail
MAIL_FROM=Project Camp <noreply@projectcamp.dev>

# ── Bootstrap admin (created on startup if none exists) ──────
# Created with isEmailVerified=true, so it is never locked behind the OTP step.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ── File uploads (optional override) ─────────────────────────
# Absolute base URL used in attachment URLs; defaults to request origin
# SERVER_URL=http://localhost:8000
